---
import Icon from "./Icon.astro";
import { site, whatsappLink } from "../data/site";
---

<footer class="bg-void py-16">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div>
        <span class="font-display text-2xl uppercase text-bone">
          Punk<span class="text-ember">'</span>kas Art Studio
        </span>
        <p class="mt-3 max-w-[38ch] text-sm text-ash">{site.tagline}</p>
      </div>

      <div class="flex gap-8 text-sm">
        <div>
          <p class="font-brand-mono text-xs uppercase tracking-wider text-ash">Jam Buka</p>
          {
            site.hours.map((slot) => (
              <p class="mt-2 text-bone">
                {slot.days} <span class="text-ash">{slot.time}</span>
              </p>
            ))
          }
        </div>

        <div>
          <p class="font-brand-mono text-xs uppercase tracking-wider text-ash">Kontak</p>
          <a
            href={whatsappLink()}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 flex items-center gap-2 text-bone transition-colors hover:text-ember"
          >
            <Icon name="whatsapp" class="h-4 w-4" />
            WhatsApp
          </a>
          <a
            href={site.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 flex items-center gap-2 text-bone transition-colors hover:text-ember"
          >
            <Icon name="instagram" class="h-4 w-4" />
            @{site.instagramHandle}
          </a>
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-border pt-6 text-xs text-ash">
      {site.address}
    </div>
  </div>
</footer>
