---
import Icon from "./Icon.astro";
import { services, flatPrice, whatsappLink } from "../data/site";
---

<section id="layanan" class="bg-surface py-20 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="reveal flex items-end justify-between gap-6">
      <h2 class="font-display text-4xl uppercase text-bone md:text-5xl">Layanan</h2>
      <Icon name="scissors" class="h-8 w-8 shrink-0 text-ember" />
    </div>

    <div class="reveal mt-12 grid gap-10 border-t border-border pt-12 md:grid-cols-2 md:items-center md:gap-16">
      <div>
        <p class="text-ash">Satu harga untuk semua gaya, tanpa nego.</p>
        <div class="mt-3 flex items-baseline gap-2">
          <span class="font-brand-mono text-xl text-ash">Rp</span>
          <span class="font-display text-7xl leading-none text-ember md:text-8xl">
            {flatPrice}
          </span>
        </div>
        <p class="mt-5 max-w-[46ch] text-ash">
          Potongan dewasa, anak-anak, cukur jenggot, sampai cuci rambut, semua rata.
          Datang saja, tidak perlu tanya harga dulu.
        </p>
      </div>

      <div class="flex flex-wrap content-start gap-3 md:justify-end">
        {
          services.map((service) => (
            <span class="border border-border px-4 py-2 text-sm text-bone">{service}</span>
          ))
        }
      </div>
    </div>

    <a
      href={whatsappLink()}
      target="_blank"
      rel="noopener noreferrer"
      class="reveal mt-10 inline-flex items-center gap-2 bg-ember px-6 py-3.5 text-sm font-semibold text-void transition-colors hover:bg-bone"
    >
      <Icon name="whatsapp" class="h-4 w-4" />
      Chat WhatsApp
    </a>
  </div>
</section>
