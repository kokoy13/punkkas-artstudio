---
import Icon from "./Icon.astro";
import { site, whatsappLink } from "../data/site";

const links = [
  { href: "#tentang", label: "Tentang" },
  { href: "#layanan", label: "Layanan" },
  { href: "#galeri", label: "Galeri" },
  { href: "#lokasi", label: "Lokasi" },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 h-[72px] border-b border-border/60 bg-void/80 backdrop-blur-md"
>
  <div class="mx-auto flex h-full max-w-6xl items-center justify-between px-5 md:px-8">
    <a href="#top" class="font-display text-xl tracking-wide text-bone">
      PUNK<span class="text-ember">'</span>KAS
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm text-ash transition-colors hover:text-bone"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={whatsappLink()}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-2 border border-ember px-4 py-2 text-sm font-medium text-ember transition-colors hover:bg-ember hover:text-void sm:flex"
      >
        <Icon name="whatsapp" class="h-4 w-4" />
        Chat WhatsApp
      </a>

      <button
        id="menu-toggle"
        type="button"
        aria-label="Buka menu"
        aria-expanded="false"
        class="flex h-10 w-10 items-center justify-center border border-border text-bone md:hidden"
      >
        <Icon name="list" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden flex-col gap-1 border-b border-border bg-void px-5 py-4 md:hidden"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class="border-b border-border/60 py-3 text-base text-bone last:border-none"
        >
          {link.label}
        </a>
      ))
    }
    <a
      href={whatsappLink()}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 flex items-center justify-center gap-2 bg-ember px-4 py-3 text-sm font-semibold text-void"
    >
      <Icon name="whatsapp" class="h-4 w-4" />
      Chat WhatsApp
    </a>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const icon = toggle?.querySelector("svg");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("flex");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      menu.classList.remove("flex");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
